#!/bin/sh
# Stands in for the Bitwarden CLI: unlocks with "correct", then lists one login.
case "$1 $2" in
  "unlock --passwordenv")
    [ "$(printenv "$3")" = correct ] || { echo "Invalid master password." >&2; exit 1; }
    echo SESSION-KEY ;;
  "list items")
    [ "$BW_SESSION" = SESSION-KEY ] || { echo "Vault is locked." >&2; exit 1; }
    echo '[{"name":"local","login":{"username":"bea","password":"pw-bea","uris":[{"uri":"http://plugin-test.localhost/"}]}}]' ;;
  *) exit 2 ;;
esac
