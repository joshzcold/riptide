#!/bin/sh
# Stands in for rbw: a login for the test site, and one for a lookalike.
case "$1 $2" in
  "search --fields") printf 'id-1\tplugin-test.localhost\tann\nid-2\tlookalike\teve\n' ;;
  "get --raw")
    case $3 in
      id-1)
        sleep "${RBW_DELAY:-0}"
        echo '{"id":"id-1","name":"plugin-test.localhost","data":{"username":"ann","password":"pw-ann","totp":null,"uris":[{"uri":"http://plugin-test.localhost/","match_type":null}]}}' ;;
      id-2) echo '{"id":"id-2","name":"lookalike","data":{"username":"eve","password":"pw-eve","uris":[{"uri":"https://plugin-test.localhost.evil.net/"}]}}' ;;
    esac ;;
  *) exit 2 ;;
esac
